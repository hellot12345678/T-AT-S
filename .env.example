# T@S (Talk. Decide. Solve.) Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-t-at-s-core-engine-key-2026-production-ready
ALLOWED_HOSTS=*

# Database: Leave blank for local SQLite zero-config testing, or provide Supabase/PostgreSQL URL
DATABASE_URL=

# Groq Cloud API (Free tier: ~14,400 requests/day, 300+ tok/s)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=

# LLM Reasoning Defaults
DEFAULT_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434

# Security & CORS
T_AT_S_SERVICE_KEY=
CORS_ALLOW_ALL_ORIGINS=True

# Render Keep-Alive (UptimeRobot ping: GET /api/v1/health/ every 10 min)
UPTIME_ROBOT_URL=https://t-at-s-engine.onrender.com/api/v1/health/

# Razorpay Live / Test Payment Gateway (Get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email SMTP Settings (For OTP Verification & Password Reset via Gmail or SendGrid)
# If left blank, OTPs and reset tokens print safely to backend console for zero-friction local testing
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=T@S Acoustic AI <noreply@tats.ai>
