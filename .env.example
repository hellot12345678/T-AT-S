# T@S (Talk. Decide. Solve.) Environment Configuration
DEBUG=True
SECRET_KEY=django-insecure-t-at-s-core-engine-key-2026-production-ready
ALLOWED_HOSTS=*

# Database: Leave blank for local SQLite zero-config testing, or provide Supabase/PostgreSQL URL
DATABASE_URL=

# Groq Cloud API (Free tier: ~14,400 requests/day, 300+ tok/s)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=

# System Defaults
DEFAULT_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434

